# Swiggy MCP probe — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored.
# NEVER put a real token, code verifier, or client secret in this file — it IS committed.
#
# There is no Swiggy API key. Authentication is OAuth 2.1 + PKCE, completed
# interactively in a browser. See: https://mcp.swiggy.com/builders/docs/start/authenticate/

# ---------------------------------------------------------------- target server
# One of: food | im | dineout
# NOTE: Instamart is "im", NOT "instamart".
SWIGGY_MCP_SERVER=food

# Point at staging instead of production.
# Staging is "same shape as production, backed by seeded data (no real orders)".
# STRONGLY preferred for any demo, test, or CI run.
# Requires staging credentials, issued by Swiggy during application review.
SWIGGY_USE_STAGING=false

# Override the base host entirely (rarely needed).
# Defaults to https://mcp.swiggy.com  (or https://mcp-staging.swiggy.com when staging).
# SWIGGY_MCP_BASE_URL=

# ---------------------------------------------------------------- OAuth
# Must be HTTPS, except http://localhost which is permitted for local development.
# Must exactly match a URI allowlisted with Swiggy (exact-match, no open redirects).
SWIGGY_OAUTH_REDIRECT_URI=http://localhost:8765/callback

# Leave BOTH blank to use Dynamic Client Registration (RFC 7591) via POST /auth/register.
# Populate only if Swiggy issued you a static client id.
# SWIGGY_OAUTH_CLIENT_ID=
# SWIGGY_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------- token storage
# Leave UNSET for memory-only storage (the safe default — token dies with the process).
# If set, the token is cached to this path with mode 0600. The path must be gitignored.
# Swiggy's rule: store tokens "in memory or secure OS storage"; never log them in plaintext.
# SWIGGY_TOKEN_FILE=.tokens.json

# ---------------------------------------------------------------- SAFETY
# MASTER SWITCH for real order placement. Keep FALSE.
#
# `place_food_order` is NOT idempotent and Swiggy exposes NO cancellation tool
# (cancellation is via customer care 080-67466729). A real order costs real money
# and sends a real delivery rider to a real address.
#
# Even when this is true, `npm run probe` still refuses to place an order — the probe
# never signals explicit order intent. Both gates must open, deliberately, in code.
THUNA_ENABLE_REAL_SWIGGY_ORDER=false

# ---------------------------------------------------------------- probe options
# Search term used by the restaurant/menu probes.
SWIGGY_PROBE_QUERY=dosa

# Skip get_addresses and use a known address id directly.
# SWIGGY_PROBE_ADDRESS_ID=

# Print full (still redacted) response payloads.
SWIGGY_PROBE_VERBOSE=false
