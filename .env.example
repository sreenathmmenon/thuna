# Thuna environment variables. Copy to .env for local dev, or set in Railway.
# NEVER commit real values. This file is committed with placeholders only.

# ---- secrets (set in Railway; never in committed files) ----
SARVAM_API_KEY=                       # REQUIRED. Sarvam API key (https://dashboard.sarvam.ai)
THUNA_TELEGRAM_BOT_TOKEN=             # OPTIONAL secret. Enables Telegram family notifications.
# THUNA_TELEGRAM_CHAT_ID=              # OPTIONAL. Paired with the bot token.

# ---- Sarvam models / voice (non-secret) ----
SARVAM_CHAT_MODEL=sarvam-30b          # sarvam-30b (fast) | sarvam-105b (flagship)
BULBUL_VOICE=abhilash                 # stable named Bulbul voice for the demo
SOURCE_LANG=en-IN                     # recognition language
TARGET_LANG=hi-IN                     # spoken guidance language

# ---- Thuna runtime (non-secret) ----
THUNA_DEMO_MODE=true                  # labels simulated provider actions clearly
# THUNA_DATA_DIR=/app/data            # Railway ONLY (set in the Railway dashboard). Leave unset locally: local dev uses <repo>/data. On macOS /app is not writable and every store write would fail.
# THUNA_MEMORY_PATH=                  # optional per-file override (else $THUNA_DATA_DIR/thuna-memory.json)
# THUNA_CONTINUITY_PATH=              # optional per-file override (else $THUNA_DATA_DIR/thuna-continuity.json)

# ---- provider safety flags (non-secret) ----
THUNA_FOOD_ADAPTER=mock               # mock | swiggy  (default = simulated provider)
# Set to swiggy for real saved-address, discovery and cart preparation on localhost.
# THUNA_FOOD_ADAPTER=swiggy
# Server-only OAuth state and tokens use the Railway volume or THUNA_DATA_DIR.
# THUNA_DATA_ROOT=./data              # optional Swiggy-only local override
# Must exactly match the redirect registered through Swiggy OAuth.
# Railway otherwise derives HTTPS from RAILWAY_PUBLIC_DOMAIN.
# THUNA_SWIGGY_CALLBACK_URL=http://localhost:3000/api/integrations/swiggy/callback
THUNA_ENABLE_REAL_SWIGGY_ORDER=false  # live placement also requires two deliberate confirmations

# ---- proactive reminder delivery (off until deliberately configured) ----
THUNA_SCHEDULER_ENABLED=false         # set true in a persistent production server
THUNA_SCHEDULER_INTERVAL_SECONDS=15
THUNA_ENABLE_REAL_TELEPHONY=false     # credentials alone never place calls
# THUNA_PUBLIC_BASE_URL=https://your-thuna-domain.example
# THUNA_TELEPHONY_WEBHOOK_SECRET=     # secret; use at least 32 random characters
# THUNA_DELIVERY_EVIDENCE_PATH=       # optional; defaults under THUNA_DATA_DIR
# THUNA_ELDER_PHONE_NUMBER=+9198XXXXXXXX
# EXOTEL_API_KEY=                     # secret
# EXOTEL_API_TOKEN=                   # secret
# EXOTEL_ACCOUNT_SID=
# EXOTEL_CALLER_ID=
# EXOTEL_API_BASE=https://api.in.exotel.com
# EXOTEL_VOICEBOT_FLOW_URL=https://my.exotel.com/<account>/exoml/start_voice/<app-id>

# ---- server (non-secret; Railway provides PORT) ----
NODE_ENV=production
# PORT=3000
