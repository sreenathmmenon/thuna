# Copy this file to .env (or rely on the home ~/.env symlink).
# NEVER put real keys in .env.example — it IS committed.

# Sarvam API (https://dashboard.sarvam.ai) — required, the core of the build
SARVAM_API_KEY=

# A single stable named Bulbul voice used for the whole demo (consistency = differentiator).
# Browse voices: https://docs.sarvam.ai/api/api-guides-tutorials/text-to-speech/voices
BULBUL_VOICE=abhilash

# BCP-47 language codes
SOURCE_LANG=hi-IN        # or en-IN — language of the source clip
TARGET_LANG=hi-IN        # dubbed output language

# Server
PORT=3000

# Optional: an LLM for the audience-aware adaptation step (your assistants can use any)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_PI_KEY=
